# GenSpark - Environment Variables
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# MailHog – emails yahan receive hongi, browser http://localhost:8025 pe dekho
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@genspark.local

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Admin@MySQL786
DB_NAME=genspark_erp

# Force Flask to use MySQL instead of SQLite
USE_SQLITE=0
