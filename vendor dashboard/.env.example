# GenSpark - Environment Variables
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Email – admin add user/vendor par one-time password is email par bheja jata hai
# MAIL_SERVER khali chhodo to email nahi bheegi (sirf flash message mein password dikhega)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
PREFERRED_URL=http://127.0.0.1:5000
# React app URL – change-password redirect + OAuth callback redirect (e.g. http://localhost:5173)
FRONTEND_URL=

# OAuth – Google & GitHub (optional). Set in Google Cloud Console / GitHub OAuth App; callback = PREFERRED_URL/api/auth/google/callback etc.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- MailHog (local): email MailHog mein get hogi, browser http://localhost:8025 pe dekho ---
# MAIL_SERVER=localhost
# MAIL_PORT=1025
# MAIL_USE_TLS=0
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@genspark.local

# Database — local dev defaults to SQLite (no MySQL install needed).
# USE_SQLITE=0 to use MySQL locally with the DB_* vars below.
USE_SQLITE=1

# MySQL (local or cloud). On Railway: never use localhost — use your cloud DB host.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=genspark_erp

# Railway MySQL plugin may expose these instead of DB_*:
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# Or a full URL:
# DATABASE_URL=mysql://user:pass@host:3306/dbname
# MYSQL_URL=mysql://...

# Railway backend service variables (example):
# FLASK_ENV=production
# USE_SQLITE=0
# SECRET_KEY=change-me
# DB_HOST=your-mysql-host.railway.app
# DB_USER=...
# DB_PASSWORD=...
# DB_NAME=railway
