# Copy to .env.local for local overrides (optional).
# Production uses .env.production (Railway URL).

# Local dev: leave unset to use Vite proxy (/api → http://127.0.0.1:5000)
# VITE_API_BASE=http://127.0.0.1:5000

# Production / preview against live API:
VITE_API_BASE=https://genspark-production.up.railway.app
