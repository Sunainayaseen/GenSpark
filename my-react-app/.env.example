# Copy to .env for local overrides (optional).
# Default: live Railway API (see .env).

# Stripe publishable key (test mode) — must match backend STRIPE_SECRET_KEY account
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Live production API (Railway)
# Live API (Railway) — keep in sync with vercel.json + src/config/deployUrls.js
VITE_API_BASE=https://genspark-production.up.railway.app

# Local dev (auto via .env.development when using npm run dev):
# VITE_API_BASE=http://127.0.0.1:5000

# Optional: recommend-build axios timeout (ms). Default 12s local, 60s prod, 90s HF.
# VITE_RECOMMEND_BUILD_TIMEOUT_MS=60000
#
# YOLO detection requires local Flask + ultralytics (pip install -r requirements.txt)
# Model weights: vendor dashboard/models/best.pt
