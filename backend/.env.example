# Copy to backend/.env — OpenAI only (Gemini removed)
# 1. https://platform.openai.com/settings/billing → Add funds ($5+)
# 2. https://platform.openai.com/api-keys → Create key → paste below

OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# Checkout currency for PaymentIntent (pkr for PKR prices, usd for USD test flow)
STRIPE_CURRENCY=pkr

# Local XAMPP
#DB_HOST=localhost
# Local Flask port (default 5001 in app.py __main__)
#PORT=5001

DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=genspark_erp

# ✅ Railway PUBLIC (works from HF Spaces + local machine)
DB_HOST=centerbeam.proxy.rlwy.net
DB_PORT=41753
DB_USER=root
DB_PASSWORD=qUapOHHQvxWPWplpXmJynWqINQvSLpYf
DB_NAME=railway

DATABASE_URL=mysql://root:qUapOHHQvxWPWplpXmJynWqINQvSLpYf@centerbeam.proxy.rlwy.net:41753/railway
MYSQL_URL=mysql://root:qUapOHHQvxWPWplpXmJynWqINQvSLpYf@centerbeam.proxy.rlwy.net:41753/railway

# Session + JWT for /api/login (match vendor dashboard SECRET_KEY in production)
FLASK_SECRET_KEY=genspark-dev-session-key
JWT_SECRET_KEY=genspark-jwt-secret-key
GENSPARK_CORS_ORIGINS=*


