# GenSpark - Environment Variables
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Email – admin add user/vendor par one-time password is email par bheja jata hai
# MAIL_SERVER khali chhodo to email nahi bheegi (sirf flash message mein password dikhega)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Backend public URL (OAuth callbacks, Flask dashboards)
# Local:
PREFERRED_URL=http://127.0.0.1:5000
# Railway production (Flask service — NOT the Vercel URL):
# PREFERRED_URL=https://genspark-production.up.railway.app

# Email verification links always use API base (see app/utils/urls.py).
# Set this on Railway if PREFERRED_URL was wrongly set to Vercel:
# API_BASE_URL=https://genspark-production.up.railway.app

# React app URL – OAuth redirect after login (Vercel or local Vite) ONLY
FRONTEND_URL=
# FRONTEND_URL=https://genspark-frontend.vercel.app
# FRONTEND_URL=http://localhost:5173

# Extra CORS origins (comma-separated), e.g. Vercel preview URLs:
# GENSPARK_CORS_ORIGINS=https://genspark-frontend-git-main-yourteam.vercel.app

# Production (Railway): set FLASK_ENV=production so session cookies use SameSite=None + Secure
# FLASK_ENV=production

# OAuth – Google & GitHub (optional). Set in Google Cloud Console / GitHub OAuth App; callback = PREFERRED_URL/api/auth/google/callback etc.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- MailHog (local): email MailHog mein get hogi, browser http://localhost:8025 pe dekho ---
# MAIL_SERVER=localhost
# MAIL_PORT=1025
# MAIL_USE_TLS=0
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@genspark.local

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_CURRENCY=pkr

# Database — this submission uses MySQL (import genspark_erp.sql first).
# Keep USE_SQLITE=0 to use the imported MySQL database with the DB_* vars below.
USE_SQLITE=0

# MySQL (local). Set DB_USER / DB_PASSWORD to YOUR MySQL login.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root              # ← your MySQL username
DB_PASSWORD=your_password # ← your MySQL password
DB_NAME=genspark_erp

# Railway MySQL plugin may expose these instead of DB_*:
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# Or a full URL:
# DATABASE_URL=mysql://user:pass@host:3306/dbname
# MYSQL_URL=mysql://...

# YOLO weights (Railway: use models/best.pt — do NOT point at ~/yolov5 paths)
# GENSPARK_YOLO_MODEL=models/best.pt

# Railway backend service variables (example):
# FLASK_ENV=production
# USE_SQLITE=0
# SECRET_KEY=change-me
# DB_HOST=your-mysql-host.railway.app
# DB_USER=...
# DB_PASSWORD=...
# DB_NAME=railway
